# ── Version control ────────────────────────────────────────────────────────────
.git
.gitignore

# ── Dependencies (will be installed fresh in deps stage) ───────────────────────
node_modules

# ── Next.js build output (built inside container) ─────────────────────────────
.next
out

# ── Development & local config ─────────────────────────────────────────────────
.env
.env.local
.env*.local
*.env

# ── TypeScript build info ──────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo
tsconfig.seed.tsbuildinfo

# ── Docs, notes, markdown files ───────────────────────────────────────────────
docs
*.md
!README.md

# ── OS / editor artifacts ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode
.idea
.antigravity

# ── Test & coverage ────────────────────────────────────────────────────────────
coverage
__tests__
*.test.ts
*.spec.ts
