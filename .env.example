# Copy this file to .env (never commit .env) and fill in YOUR OWN values.
# Every value below is a placeholder. Nothing here is a real credential.

# ── Database (MongoDB, must be a replica set: the app uses interactive transactions) ───
# Local Docker:   mongodb://USER:PASSWORD@localhost:27017/portal_db?replicaSet=rs0&authSource=admin
# MongoDB Atlas:  mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/portal_db?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://befhue8080:befhue8080@portal.nrpv02p.mongodb.net/portal_db?retryWrites=true&w=majority"

# Only used by docker-compose.yml to start a local MongoDB
DB_USER=befhue8080
DB_PASSWORD=befhue8080
DB_NAME=portal_db

# ── Sign-in (NextAuth / Auth.js) ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Generate each with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# ── First admin account (used only by `npm run seed`; there is NO default account) ───
ADMIN_EMAIL="gokulm3127@gmial.com"
ADMIN_PASSWORD="gokulprasath"        # at least 12 characters, unique, never reused
ADMIN_NAME="Admin"
COMPANY_NAME="My Company"
COMPANY_ADDRESS=""

# ── Password vault encryption (set BEFORE anyone saves a login; never change it afterwards) ──
# Generate with: openssl rand -base64 48
VAULT_KEY=""

# ── Scheduled jobs: protects /api/cron/* ──────────────────────────────────────
CRON_SECRET=""

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="My Company <noreply@your-domain.example>"

# ── File storage (optional): avatars, documents ───────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Slack notifications (optional) ────────────────────────────────────────────
SLACK_BOT_TOKEN=""       # starts with xoxb-
SLACK_CHANNEL_ID=""      # starts with C

# ── Meta Ads (optional) ───────────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_API_VERSION="v23.0"

# ── MCP server (optional, only for mcp-server/) ───────────────────────────────
DESK_API_URL="http://localhost:3000"
DESK_API_TOKEN=""
