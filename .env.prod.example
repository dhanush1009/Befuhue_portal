# ── Database (MongoDB Atlas — managed, cloud-hosted) ──────────────────────────
# From the Atlas dashboard: Database → Connect → Drivers. Atlas's mongodb+srv://
# already resolves to its replica set members via DNS, so no ?replicaSet= param
# is needed (required regardless — the app uses Prisma's interactive
# $transaction(), which MongoDB only supports on a replica set).
# Also add the EC2 instance's IP (or 0.0.0.0/0 for simplicity on a small
# single-server deploy) to Atlas's Network Access list, or the app can't connect.
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/portal_db?retryWrites=true&w=majority&appName=<appName>

# ── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Public HTTPS URL of the app, once Caddy is fronting it with a real cert
AUTH_URL=https://portal.your-domain.example
NEXTAUTH_URL=https://portal.your-domain.example
# Required behind a reverse proxy (Caddy) — NextAuth must trust forwarded host/proto headers
AUTH_TRUST_HOST=true
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_a_strong_secret_here

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP Mail ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Deep Impression <your_email@gmail.com>

# ── Supabase (optional — for realtime) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS S3 (for file uploads) ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=your-s3-bucket

# ── Cron secret ───────────────────────────────────────────────────────────────
# Used to protect /api/cron/due-reminders
CRON_SECRET=generate_a_random_secret_here
