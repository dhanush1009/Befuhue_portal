model ProjectReport {
  id              String              @id @default(cuid()) @map("_id")
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id])
  month           Int                 // 1–12
  year            Int
  title           String              // e.g. "Deep Impression — June 2026 Report"
  generatedById   String
  generatedBy     User                @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generatedAt     DateTime            @default(now())

  // Snapshot of report data (JSON — so it never changes after save)
  reportData      Json                // full report payload stored on save

  status          ReportStatus        @default(DRAFT)

  // Sharing
  shareToken      String?             @unique  // UUID token for public link
  shareExpiresAt  DateTime?
  isPublic        Boolean             @default(false)

  // Notes added by admin when saving
  notes           String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([projectId, month, year])
}

enum ReportStatus {
  DRAFT       // generated but not saved as snapshot
  SAVED       // frozen snapshot saved to DB
  SHARED      // shared via public link
  ARCHIVED    // no longer active
}

// Company holiday calendar (mandatory leave days like Diwali, Pongal, New Year).
// One per calendar day; `date` is noon-UTC of the IST day, like Attendance.date.
model Holiday {
  id        String   @id @default(cuid()) @map("_id")
  date      DateTime @unique
  name      String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssignMode {
  SINGLE
  TOGETHER
  OFFER
}

enum ParticipantKind {
  COLLABORATOR // owns a part of a TOGETHER task
  OFFEREE      // was offered an OFFER task and hasn't accepted (or lost the race)
}

// Who is on a task besides (or instead of) the single assignee. A TOGETHER task has one
// COLLABORATOR row per person (each with their own "my part done" flag); an open OFFER task
// has one OFFEREE row per person it was offered to. Offer rows are removed once someone accepts.
model TaskParticipant {
  id         String          @id @default(cuid()) @map("_id")
  taskId     String
  task       Task            @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId     String
  user       User            @relation("TaskParticipations", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind       ParticipantKind
  role       String?         // free label, e.g. "Designer"
  partDone   Boolean         @default(false)
  partDoneAt DateTime?
  createdAt  DateTime        @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

// ── Meta Ads ──────────────────────────────────────────────────────────────────
// Daily performance pulled from the Meta Marketing API (see src/lib/meta). Accounts are
// discovered from Meta, switched on by an admin, and mapped to a portal Client by hand.

enum MetaLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
}

model MetaAdAccount {
  id              String    @id @default(cuid()) @map("_id")
  accountId       String    @unique // numeric Meta id, without the "act_" prefix
  name            String
  currency        String    @default("INR")
  timezoneName    String?
  accountStatus   String?   // ACTIVE, DISABLED, UNSETTLED, CLOSED ...
  businessName    String?
  clientId        String?   // chosen by an admin - never matched automatically
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isEnabled       Boolean   @default(false) // only enabled accounts are synced
  resultAction    String?   // which result to headline (action_type); null = automatic
  customConversions Json?   // { "<custom conversion id>": "<name>" }
  lastSyncedAt    DateTime?
  lastSyncError   String?
  syncedFrom      String?   // earliest day we hold, yyyy-MM-dd
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One row per account/campaign/ad set/ad per day. Dates are the ad account's own calendar day.
model MetaInsightDaily {
  id           String    @id @default(cuid()) @map("_id")
  accountId    String
  date         String    // yyyy-MM-dd
  level        MetaLevel
  objectId     String    // the account id for ACCOUNT rows
  objectName   String
  campaignId   String?
  adsetId      String?
  objective    String?
  spend        Float     @default(0)
  impressions  Int       @default(0)
  reach        Int       @default(0)
  clicks       Int       @default(0)
  linkClicks   Int       @default(0)
  actions      Json?     // { action_type: count }
  actionValues Json?     // { action_type: value }

  @@unique([accountId, date, level, objectId])
  @@index([accountId, level, date])
}

// Account-level splits (age & gender, placement, device) per day.
model MetaBreakdownDaily {
  id           String   @id @default(cuid()) @map("_id")
  accountId    String
  date         String   // yyyy-MM-dd
  breakdown    String   // age_gender | placement | device
  key          String   // e.g. "25-34|female", "facebook|feed", "mobile_app"
  spend        Float    @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  actions      Json?
  actionValues Json?

  @@unique([accountId, date, breakdown, key])
  @@index([accountId, breakdown, date])
}

// The Meta login an admin connected from the portal ("Connect Meta"). One row, id "default".
// The access token is stored encrypted (AES-256-GCM); it is never sent to the browser.
model MetaConnection {
  id              String    @id @map("_id")
  tokenEncrypted  String
  expiresAt       DateTime?
  metaUserId      String?
  metaUserName    String?
  scopes          String[]  @default([])
  connectedById   String?
  connectedAt     DateTime  @default(now())
  lastRefreshedAt DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt
}


// ── Employee details (HR record the employee fills in about themselves) ─────────────────────────
// Every field is optional. Bank account, PAN, Aadhaar and UAN are stored encrypted ("...Enc") with
// only the last 4 characters kept readable ("...Last4") so screens can show them masked.

type DetailsAddress {
  line1   String?
  line2   String?
  city    String?
  state   String?
  pincode String?
}

type DetailsNominee {
  name         String
  relationship String
  dateOfBirth  DateTime?
  sharePercent Int
  phone        String?
}

type DetailsAsset {
  type       String   // LAPTOP | PHONE | SIM | ID_CARD | ACCESS_CARD | OTHER
  name       String
  serial     String?
  issuedOn   DateTime?
  returnedOn DateTime?
  notes      String?
}

model EmployeeDetails {
  id     String @id @default(cuid()) @map("_id")
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Personal
  preferredName  String?
  dateOfBirth    DateTime?
  hideBirthday   Boolean   @default(false)   // keep off the team birthdays card
  gender         String?
  bloodGroup     String?
  maritalStatus  String?
  nationality    String?
  personalEmail  String?
  altPhone       String?
  languages      String[]
  tshirtSize     String?
  currentAddress   DetailsAddress?
  permanentAddress DetailsAddress?
  sameAddress      Boolean @default(false)

  // Emergency
  emergencyName      String?
  emergencyRelation  String?
  emergencyPhone     String?
  emergency2Name     String?
  emergency2Relation String?
  emergency2Phone    String?
  medicalNotes       String?

  // Bank
  bankHolderName     String?
  bankName           String?
  bankBranch         String?
  ifsc               String?
  accountType        String?
  bankAccountEnc     String?
  bankAccountLast4   String?

  // Government IDs
  panEnc       String?
  panLast4     String?
  aadhaarEnc   String?
  aadhaarLast4 String?
  uanEnc       String?
  uanLast4     String?

  // Education & experience
  highestQualification String?
  institute            String?
  passingYear          Int?
  totalExperienceYears Float?
  previousEmployer     String?
  previousRole         String?
  previousDuration     String?
  skills               String?
  linkedinUrl          String?

  // Nominees (PF / insurance)
  nominees DetailsNominee[]

  // Admin-only
  relievingLetterSubmitted Boolean   @default(false)
  backgroundCheckDone      Boolean   @default(false)
  backgroundCheckDate      DateTime?
  noticePeriodDays         Int?
  workLocation             String?   // OFFICE | REMOTE | HYBRID
  assets                   DetailsAsset[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


// ── Career timeline (admin only): promotions and other milestones after joining ───────────────────
// Joining itself is not stored here - it is read from User.joiningDate and shown first on the timeline.
model CareerEvent {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type            String   // PROMOTION | ROLE_CHANGE | TRANSFER | CONFIRMATION | OTHER
  effectiveDate   DateTime // a whole day, stored at noon UTC
  title           String
  fromDesignation String?
  toDesignation   String?
  note            String?
  createdById     String
  createdAt       DateTime @default(now())

  @@index([userId, effectiveDate])
}


// Remembers one-off Slack channel posts (e.g. "celebrations:2026-10-11") so a cron that runs twice does not post twice.
model SlackPostLog {
  key       String   @id @map("_id")
  createdAt DateTime @default(now())
}


// ── Joining date change requests: an employee asks, any other admin approves ───────────────────────
model JoiningDateRequest {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  currentDate   DateTime?          // what it was when they asked
  requestedDate DateTime           // a whole day, stored at noon UTC
  reason        String
  status        String   @default("PENDING")   // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// ── Password vault ─────────────────────────────────────────────────────────────────────────────────
// One entry per login that belongs to a brand (a Client). Username, password and notes are stored
// encrypted ("...Enc"); everything else (brand, service, domain) is visible to every signed-in person.
model Credential {
  id          String   @id @default(cuid()) @map("_id")
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service     String             // e.g. "Hostinger"
  domain      String?            // e.g. "hostinger.com" - shown to everyone
  label       String?            // e.g. "Hosting panel"
  loginUrl    String?
  usernameEnc String
  passwordEnc String
  notesEnc    String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

enum CredentialAccessStatus {
  PENDING
  APPROVED
  DENIED
  USED
  CANCELLED
}

// A person asking to see one entry once. Approval opens a single viewing window; viewing it uses it up.
model CredentialAccess {
  id           String                 @id @default(cuid()) @map("_id")
  credentialId String
  requesterId  String
  taskId       String?
  reason       String
  status       CredentialAccessStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  expiresAt    DateTime?              // set on approval: the viewing window closes then
  usedAt       DateTime?
  createdAt    DateTime               @default(now())

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@index([credentialId])
}
